# Step CA secrets - keep only encrypted files
step-data/secrets/intermediate_ca_key
step-data/secrets/root_ca_key
step-data/secrets/password
!step-data/secrets/*.enc

# Generated certificates
www/certs/

# Database lock
step-data/db/LOCK

# macOS
.DS_Store

# -*- mode: gitignore; -*-
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Org-mode
.org-id-locations
*_archive

# flymake-mode
*_flymake.*

# eshell files
/eshell/history
/eshell/lastdir

# elpa packages
/elpa/

# reftex files
.rel

# AUCTeX auto folder
/auto/

# cask packages
.cask/
dist/

# Flycheck
flycheck_*.el

# server auth directory
/server/

# projectiles files
.projectile

# directory configuration
.dir-locals.el

# network security
/network-security.data
